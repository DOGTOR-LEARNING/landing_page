# Site
NEXT_PUBLIC_SITE_URL=https://dogtor.superb-tutor.com
NEXT_PUBLIC_API_BASE_URL=https://superb-backend-1041765261654.asia-east1.run.app
API_BASE_URL=https://superb-backend-1041765261654.asia-east1.run.app

# PostHog（NEXT_PUBLIC_POSTHOG_HOST 留 /ingest 走 next.config.js 的反向代理，
# 這樣事件從自家網域送出，比較不會被 LINE / IG 等 in-app 瀏覽器擋掉）
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Android asset links
ANDROID_SHA256_FINGERPRINT=

# Admin
# Employee authentication service origin (no /admin suffix)
ADMIN_AUTH_BACKEND_URL=
# Canonical website origin when running behind a reverse proxy
ADMIN_PUBLIC_ORIGIN=
# 財務報帳（/admin/finance）：員工登入後才可用；伺服器用此 key 呼叫後端 /finance（與後端 FINANCE_API_KEY 相同），後端網址預設沿用 API_BASE_URL
FINANCE_API_KEY=
FINANCE_BACKEND_URL=

# Backend services (Chinese / 中文版 app)
BACKEND_Announcement_URL=
BACKEND_NOTIFICATIONS_URL=

# Backend services (English / 英文版 app)
BACKEND_Announcement_URL_EN=https://superb-backend-en-1041765261654.asia-east1.run.app
BACKEND_NOTIFICATIONS_URL_EN=https://superb-backend-en-1041765261654.asia-east1.run.app

# LINE (LIFF)
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LINE_BOT_URL=https://lin.ee/YOUR_LINE_BOT_ID

# ECPay
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_PAYMENT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# Paddle
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_SANDBOX=true
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
# Long random secret. Visit /subscribe?preview=<this value> to reach the
# checkout without LINE sign-in (for payment-provider review). Leave unset to disable.
PADDLE_PREVIEW_TOKEN=
# Single shared promo campaign surfaced from LINE (e.g. an expiry-reminder
# push with a "Subscribe now" button). /subscribe?discount=<code> must match
# NEXT_PUBLIC_PADDLE_PROMO_DISCOUNT_CODE (case-insensitive) before the mapped
# Paddle discount ID gets pre-applied to checkout. Leave both unset to disable.
NEXT_PUBLIC_PADDLE_PROMO_DISCOUNT_CODE=
NEXT_PUBLIC_PADDLE_PROMO_DISCOUNT_ID=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
